#cloud-config
users:
  - name: debian
    gecos: Debian Portable User
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: debian
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDmWkl8qZKjGSwNIiLinyIi1yKFP6NPO6+fvHB1/W8xR User@DESKTOP-QCF7KU1

ssh_pwauth: true
chpasswd:
  expire: false
write_files:
  - path: /etc/inputrc.d/portable.inputrc
    content: |
      set enable-bracketed-paste on
  - path: /etc/nanorc.d/portable.nanorc
    content: |
      unbind ^J main
      set softwrap
      set tabstospaces
      set tabsize 4
  - path: /etc/dpkg/dpkg.cfg.d/force-unsafe-io
    content: |
      force-unsafe-io
  - path: /etc/apt/apt.conf.d/99speedup
    content: |
      Acquire::Languages "none";
      Acquire::PDiffs "false";
      Acquire::ForceIPv4 "true";
  - path: /etc/apt/sources.list.d/debian.sources
    content: |
      Types: deb
      URIs: http://ftp.jaist.ac.jp/debian
      Suites: trixie trixie-updates trixie-backports
      Components: main contrib non-free non-free-firmware
      Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

      Types: deb
      URIs: http://security.debian.org/debian-security
      Suites: trixie-security
      Components: main contrib non-free non-free-firmware
      Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
  - path: /etc/cloud/cloud-init.disabled
    content: |
      disabled
bootcmd:
  - echo "nameserver 1.1.1.1" > /etc/resolv.conf
  - echo "nameserver 8.8.8.8" >> /etc/resolv.conf
  - echo "options timeout:1 attempts:2 single-request" >> /etc/resolv.conf
