#cloud-config
# This file is dynamically populated during init.bat with your machine's SSH key.
users:
  - name: debian
    gecos: Debian Portable User
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: debian
    shell: /bin/bash

ssh_pwauth: true
chpasswd:
  expire: false

write_files:
  - path: /etc/inputrc.d/portable.inputrc
    content: |
      set enable-bracketed-paste on
  - path: /etc/nanorc.d/portable.nanorc
    content: |
      unbind ^J main
      set softwrap
      set tabstospaces
      set tabsize 4
